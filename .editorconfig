root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 140
tab_width = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
indent_style = space
ij_kotlin_keep_blank_lines_before_right_brace = 0
ij_kotlin_keep_blank_lines_in_code = 1
ij_kotlin_keep_blank_lines_in_declarations = 1

[*.{xml,yaml,yml}]
indent_size = 4
indent_style = space

[*.md]
max_line_length = off
trim_trailing_whitespace = false

# SDK files use wildcard imports for CaptureSetting.* enum values
[{CameraOfflineData.kt,InstaCameraManagerExt.kt}]
ktlint_standard_no-wildcard-imports = disabled
