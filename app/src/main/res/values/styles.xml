<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextStyle.Main" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight">24dp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextStyle.Main.White" parent="TextStyle.Main">
        <item name="android:textColor">@color/paper</item>
    </style>

    <style name="TextStyle.Main.Button" parent="TextStyle.Main">
        <item name="android:textColor">@color/paper</item>
        <item name="android:background">@drawable/main_button_bg</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="TextStyle.Main.Check" parent="TextStyle.Main.Button">
        <item name="android:textColor">@color/paper</item>
        <item name="android:background">@drawable/main_select_bg</item>
    </style>

    <style name="BaseDialogStyle" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.8</item>
    </style>

    <style name="MaterialPreference.SwitchPreference" parent="Preference.SwitchPreferenceCompat">
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink</item>
    </style>

    <style name="Widget.Immersive.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_secondary_bg</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:paddingStart">32dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Immersive.Button.Primary">
        <item name="android:background">@drawable/btn_primary_bg</item>
        <item name="android:textColor">@color/paper</item>
    </style>
</resources>
